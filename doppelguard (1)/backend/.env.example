# Backend Environment Variables
PORT=8000
HOST=0.0.0.0

# Database Configuration
# Defaults to SQLite if not provided or left blank
DATABASE_URL=sqlite:///./doppelguard.db
# PostgreSQL Example:
# DATABASE_URL=postgresql://user:password@localhost:5432/doppelguard

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
